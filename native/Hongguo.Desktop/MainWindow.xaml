<Window x:Class="Hongguo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hongguo.Desktop"
        Title="" AutomationProperties.Name="红果原生桌面版" Width="1380" Height="900"
        Background="{StaticResource WindowBrush}" Foreground="#F5F6FA"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="PlayerMenuRow" TargetType="Button">
            <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#ECEDF0" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="RowSurface" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <Grid><Border x:Name="RowHover" Background="White" Opacity="0" CornerRadius="6" /><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" /></Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowHover" Property="Opacity" Value="0.06" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="#727C8B" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="RowSurface" Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlayerIconButton" TargetType="Button" BasedOn="{StaticResource PlayerMenuRow}">
            <Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PosterButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#F5F6FA" />
            <Setter Property="Padding" Value="0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="CardFrame" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="2">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardFrame" Property="Background" Value="#171B24" /><Setter TargetName="CardFrame" Property="BorderBrush" Value="#343B49" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="CardFrame" Property="Opacity" Value="0.75" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CardFrame" Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RankListRowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#12161E" /><Setter Property="BorderBrush" Value="#252C38" />
            <Setter Property="Padding" Value="15,14" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="142" />
        </Style>
        <Style x:Key="NavigationLabel" TargetType="TextBlock">
            <Style.Triggers><DataTrigger Binding="{Binding CompactLayout, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="NavigationGlyph" TargetType="Path">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Style.Triggers><DataTrigger Binding="{Binding CompactLayout, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True"><Setter Property="Margin" Value="0" /></DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <ScrollViewer x:Name="ShellViewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CanContentScroll="False">
    <Grid x:Name="RootLayout">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="178" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border x:Name="NavigationPanel" Background="#101219" BorderBrush="#20242E" BorderThickness="0,0,1,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <Grid x:Name="NavigationContent" Margin="16,30,16,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel x:Name="BrandPanel" Margin="10,0,0,34">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="BrandGlyph" Width="28" Height="28" CornerRadius="9" Background="{StaticResource AccentBrush}" Margin="0,2,9,0"><Path Data="M 0 0 L 0 12 L 10 6 Z" Fill="#181117" Width="10" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" /></Border>
                        <TextBlock Text="红果" Style="{StaticResource NavigationLabel}" FontSize="25" FontWeight="Bold" Foreground="#F5F6FA" />
                    </StackPanel>
                    <TextBlock Text="好故事，随时入戏。" Style="{StaticResource NavigationLabel}" Foreground="#737D90" FontSize="10" Margin="0,12,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="我的影院" Style="{StaticResource NavigationLabel}" FontSize="10" Foreground="#596477" Margin="12,0,0,12" />
                    <Button x:Name="DiscoverNav" Style="{StaticResource NavigationButton}" Tag="active" Margin="0,3" Click="Discover_Click" AutomationProperties.AutomationId="DiscoverNav" AutomationProperties.Name="发现好剧">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationGlyph}" Data="M 2 8 L 10 2 L 18 8 L 18 18 L 12 18 L 12 12 L 8 12 L 8 18 L 2 18 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform" /><TextBlock Style="{StaticResource NavigationLabel}" Text="发现好剧" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" /></StackPanel>
                    </Button>
                    <Button x:Name="FeedNav" Style="{StaticResource NavigationButton}" Margin="0,3" Click="Feed_Click" AutomationProperties.AutomationId="FeedNav" AutomationProperties.Name="连续推荐">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationGlyph}" Data="M 3 2 L 3 18 L 17 10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform" /><TextBlock Style="{StaticResource NavigationLabel}" Text="连续推荐" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" /></StackPanel>
                    </Button>
                    <Button x:Name="RankingNav" Style="{StaticResource NavigationButton}" Margin="0,3" Click="Ranking_Click" AutomationProperties.AutomationId="RankingNav" AutomationProperties.Name="排行榜">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationGlyph}" Data="M 6 3 L 14 3 L 14 8 C 14 14 6 14 6 8 Z M 6 5 L 2 5 L 2 7 C 2 10 4 11 7 11 M 14 5 L 18 5 L 18 7 C 18 10 16 11 13 11 M 10 13 L 10 18 M 6 18 L 14 18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform" /><TextBlock Style="{StaticResource NavigationLabel}" Text="排行榜" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" /></StackPanel>
                    </Button>
                    <Button x:Name="HistoryNav" Style="{StaticResource NavigationButton}" Margin="0,3" Click="History_Click" AutomationProperties.AutomationId="HistoryNav" AutomationProperties.Name="观看记录">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationGlyph}" Data="M 3 10 A 7 7 0 1 1 5 15 M 3 4 L 3 10 L 9 10 M 10 6 L 10 10 L 13 12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform" /><TextBlock Style="{StaticResource NavigationLabel}" Text="观看记录" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" /></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="NavigationFooter" Grid.Row="3" Margin="12,0,0,0">
                    <TextBlock Text="把这一刻，交给故事。" Style="{StaticResource NavigationLabel}" FontSize="10" Foreground="#647084" Margin="0,0,0,18" />
                    <Button Style="{StaticResource GhostButton}" Click="About_Click" HorizontalAlignment="Left" Padding="0,5" Foreground="#7A8496" ToolTip="版本与应用信息" AutomationProperties.Name="应用信息"><StackPanel Orientation="Horizontal"><TextBlock x:Name="AboutCompactGlyph" Text="ⓘ" Visibility="Collapsed" FontSize="19" /><TextBlock Text="应用信息" Style="{StaticResource NavigationLabel}" FontSize="10" Foreground="#7A8496" /><TextBlock Text="1.0" Style="{StaticResource NavigationLabel}" FontSize="10" Foreground="#465064" Margin="12,0,0,0" /></StackPanel></Button>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>
        <Grid Grid.Column="1" x:Name="MainLayout">
            <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="104" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border x:Name="HeaderPanel" BorderBrush="#20242E" BorderThickness="0,0,0,1" Padding="28,22">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SearchColumn" Width="330" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock x:Name="PageEyebrow" Text="为下一段故事，留一点时间" Foreground="#717D90" FontSize="10" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="PageTitle" Text="发现好剧" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <Border x:Name="SearchEntry" Grid.Column="1" Background="#141820" BorderBrush="#292F3B" BorderThickness="1" CornerRadius="12" Height="44" Padding="6,0,12,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="SearchTabCombo" SelectedIndex="1" SelectionChanged="SearchTab_Changed" Margin="0,4,5,4" MinWidth="70" Background="Transparent" BorderThickness="0" AutomationProperties.Name="搜索分类"><ComboBoxItem Content="综合" Tag="综合" /><ComboBoxItem Content="剧集" Tag="剧集" /><ComboBoxItem Content="视频" Tag="视频" /></ComboBox>
                            <Border Grid.Column="1" Background="#2A303B" Margin="0,12" />
                            <Grid Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock Text="搜索剧名或关键词" Foreground="#596577" VerticalAlignment="Center" FontSize="12" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <TextBox x:Name="SearchInput" Text="" MaxLength="100" Background="Transparent" Foreground="#F5F6FA" CaretBrush="{StaticResource AccentBrush}" BorderThickness="0" Padding="0" FontSize="12" VerticalContentAlignment="Center" KeyDown="SearchInput_KeyDown" ToolTip="输入剧名或关键词，按回车搜索" AutomationProperties.Name="搜索短剧" AutomationProperties.AutomationId="SearchInput" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Popup x:Name="SearchSuggestionsPopup" PlacementTarget="{Binding ElementName=SearchEntry}" Placement="Bottom" VerticalOffset="7" AllowsTransparency="True" StaysOpen="False" Focusable="False">
                        <Border Background="#171C25" BorderBrush="#343D4B" BorderThickness="1" CornerRadius="12" Padding="7">
                            <StackPanel>
                                <TextBlock Text="搜索联想" FontSize="10" Foreground="#8190A6" Margin="9,5,9,7" />
                                <ListBox x:Name="SearchSuggestionsList" Background="Transparent" BorderThickness="0" Foreground="#F1F4FA" FontSize="12" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="264" AutomationProperties.Name="剧名搜索联想">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" /><Setter Property="Padding" Value="10,10" /><Setter Property="Margin" Value="0,1" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="SuggestionRow" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Foreground="#E8EDF5" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SuggestionRow" Property="Background" Value="#263040" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="SuggestionRow" Property="Background" Value="#45302A" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                                    </Style></ListBox.ItemContainerStyle>
                                </ListBox>
                                <TextBlock x:Name="SearchSuggestionsStatus" Text="正在联想…" FontSize="11" Foreground="#9AA8BD" Margin="10,8" TextWrapping="Wrap" />
                                <TextBlock Text="↑↓ 选择 · Enter 搜索 · Esc 收起" FontSize="9" Foreground="#718097" Margin="9,7,9,3" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button x:Name="SearchButton" Grid.Column="2" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Height="44" Padding="18,0" VerticalAlignment="Center" Click="Search_Click" AutomationProperties.AutomationId="SearchButton" AutomationProperties.Name="搜索"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M 14 8 A 6 6 0 1 1 2 8 A 6 6 0 1 1 14 8 M 12.5 12.5 L 18 18" Stroke="#21171B" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" /><TextBlock Text="搜索" FontSize="12" FontWeight="SemiBold" Foreground="#21171B" /></StackPanel></Button>
                </Grid>
            </Border>
            <Border x:Name="NoticeBar" Grid.Row="1" Background="#2B201F" Padding="24,12" Visibility="Collapsed" BorderBrush="#5B3832" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#F5B8A8" FontSize="12" VerticalAlignment="Center" /><Button Grid.Column="1" x:Name="RetryButton" Content="重试" Style="{StaticResource GhostButton}" Padding="14,6" Margin="15,0,0,0" Click="Retry_Click" /></Grid></Border>
            <Grid Grid.Row="2">
                <Grid x:Name="CatalogScreen" Margin="26,22,18,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="2,0,10,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel x:Name="ChannelTabs" Orientation="Horizontal"><Button Content="推荐" Tag="推荐" Style="{StaticResource ChannelButton}" Click="Channel_Click" Margin="0,0,8,0" /><Button Content="真人剧" Tag="真人剧" Style="{StaticResource ChannelButton}" Click="Channel_Click" Margin="0,0,8,0" /><Button Content="漫剧" Tag="漫剧" Style="{StaticResource ChannelButton}" Click="Channel_Click" Margin="0,0,8,0" /><Button Content="电影" Tag="电影" Style="{StaticResource ChannelButton}" Click="Channel_Click" /></StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Click="Refresh_Click" Foreground="#9AA4B5" Padding="12,8" AutomationProperties.Name="刷新推荐"><StackPanel Orientation="Horizontal"><Path Data="M 16 8 A 7 7 0 1 0 16 13 M 16 2 L 16 8 L 10 8" Stroke="#9AA4B5" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" Margin="0,1,7,0" /><TextBlock Text="换一批" FontSize="11" Foreground="#9AA4B5" /></StackPanel></Button>
                    </Grid>
                    <Border x:Name="GenreFilterPanel" Grid.Row="1" Background="#11151D" BorderBrush="#242B36" BorderThickness="1" CornerRadius="12" Margin="2,0,10,18" Padding="14,11">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button x:Name="GenrePanelToggleButton" Content="按题材找剧 ▾" Style="{StaticResource GhostButton}" Padding="0,4" Foreground="#C5CEDC" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" Click="GenrePanelToggle_Click" ToolTip="展开或收起题材选项" />
                                <Button x:Name="ClearGenresButton" Grid.Column="1" Style="{StaticResource GhostButton}" Click="ClearGenres_Click" Content="全部题材" FontSize="10" Foreground="#9AA7BC" Padding="9,4" ToolTip="清除题材筛选" />
                            </Grid>
                            <ScrollViewer x:Name="GenreOptionsScroll" Grid.Row="1" MaxHeight="116" Margin="0,9,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="GenreGroupsPanel" /></ScrollViewer>
                            <TextBlock x:Name="GenreHint" Grid.Row="2" Text="正在读取平台题材…" Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2" x:Name="CatalogScroll" ScrollChanged="CatalogScroll_Changed" Padding="0,0,4,0">
                        <ItemsControl x:Name="CatalogItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:SeriesItem}">
                                <Button Width="174" Style="{StaticResource PosterButton}" Margin="0,0,12,22" Click="Series_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Width="168">
                                        <Grid Width="168" Height="236"><Grid.Clip><RectangleGeometry Rect="0,0,168,236" RadiusX="10" RadiusY="10" /></Grid.Clip><Border Background="#1B2330" />
                                            <StackPanel VerticalAlignment="Center" Margin="14"><TextBlock Text="红果" FontSize="24" FontWeight="Bold" Foreground="#3B475B" HorizontalAlignment="Center" /><TextBlock Text="{Binding Title}" TextAlignment="Center" TextWrapping="Wrap" Foreground="#758198" FontSize="10" Margin="0,12,0,0" MaxHeight="46" /></StackPanel>
                                            <Image local:CoverImages.Url="{Binding CoverUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Border Height="90" VerticalAlignment="Bottom"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0010151D" Offset="0" /><GradientStop Color="#E6090B10" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                            <TextBlock Text="{Binding EpisodeLabel}" FontSize="10" Foreground="#F1F3F6" Margin="11,0,11,10" VerticalAlignment="Bottom" />
                                            <Border Width="38" Height="38" CornerRadius="19" Background="#E6FF765D" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger></Style.Triggers></Style></Border.Style><Path Data="M 0 0 L 0 13 L 11 6.5 Z" Fill="#24191D" Width="11" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" /></Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="1,12,1,0" ToolTip="{Binding Title}" /><TextBlock Text="{Binding CategoryLabel}" Foreground="#6C788D" FontSize="10" TextTrimming="CharacterEllipsis" Margin="1,6,1,5" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid x:Name="CatalogFooter" Grid.Row="3" Margin="0,5,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="CatalogStatus" Text="正在寻找下一段好故事…" Foreground="#69768A" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,14,0" /><Button Grid.Column="1" x:Name="MoreButton" Content="继续发现" Style="{StaticResource GhostButton}" Click="More_Click" Padding="14,7" FontSize="11" Visibility="Collapsed" /></Grid>
                </Grid>
                <Grid x:Name="PlayerScreen" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid x:Name="PlayerHeading" Margin="24,20,24,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="PlayerBackButton" Style="{StaticResource IconButton}" Click="Back_Click" Margin="0,0,16,0" ToolTip="返回" AutomationProperties.Name="返回"><Path Data="M 11 2 L 3 10 L 11 18 M 3 10 L 19 10" Stroke="#D2D7E2" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" /></Button>
                        <StackPanel x:Name="PlayingTitleGroup" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock x:Name="PlayingTitle" Text="准备播放" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="PlayingSubtitle" Text="请选择分集" Foreground="#748299" FontSize="10" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="EpisodePickerButton" Style="{StaticResource GhostButton}" Content="选集" Click="EpisodePicker_Click" Padding="13,10" Margin="0,0,6,0" Visibility="Collapsed" FontSize="11" ToolTip="选集、剧集详情与互动信息" AutomationProperties.Name="打开选集" />
                            <Button x:Name="NextRecommendationButton" Style="{StaticResource GhostButton}" Click="NextRecommendation_Click" Padding="15,10" ToolTip="切换到下一个推荐故事" AutomationProperties.Name="换一个推荐"><StackPanel Orientation="Horizontal"><Path Data="M 2 4 L 5 4 C 8 4 10 16 13 16 L 18 16 M 2 16 L 5 16 C 8 16 10 4 13 4 L 18 4 M 15 1 L 18 4 L 15 7 M 15 13 L 18 16 L 15 19" Stroke="#A0ABBD" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="换个故事" FontSize="11" Foreground="#A0ABBD" /></StackPanel></Button>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" x:Name="CinemaLayout">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="EpisodeColumn" Width="312" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition x:Name="PlaybackControlsRow" Height="Auto" /></Grid.RowDefinitions>
                        <Border x:Name="VideoBorder" Background="Black" Margin="24,0,0,0" BorderBrush="#20252F" BorderThickness="1,1,1,0" CornerRadius="12,12,0,0" ClipToBounds="True"><Grid>
                            <StackPanel x:Name="VideoPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="25"><Border Width="60" Height="60" CornerRadius="30" Background="#161B25" HorizontalAlignment="Center"><Path Data="M 0 0 L 0 20 L 17 10 Z" Stroke="#566078" StrokeThickness="1.4" Width="17" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" /></Border><TextBlock x:Name="VideoMessage" Text="故事即将开始…" HorizontalAlignment="Center" Foreground="#7B879A" FontSize="12" Margin="0,20,0,0" TextWrapping="Wrap" /></StackPanel>
                            <local:NativeVideoHost x:Name="VideoHost" Visibility="Hidden" />
                        </Grid></Border>
                        <!-- 控制区与视频 HWND 分开布局，保证窗口内始终可点击。 -->
                        <Border Grid.Row="1" x:Name="PlayerControls" Height="44" Background="#141820" Margin="24,0,0,12" Padding="10,0" BorderBrush="#262B35" BorderThickness="1,0,1,1" CornerRadius="0,0,12,12">
                                <Grid x:Name="ControlGroups" VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="1" Value="0" IsEnabled="False" IsMoveToPointEnabled="True" Height="20" Margin="12,0,16,0" VerticalAlignment="Center" PreviewMouseLeftButtonDown="Seek_Begin" PreviewMouseLeftButtonUp="Seek_End" ValueChanged="Seek_Changed" AutomationProperties.AutomationId="SeekSlider" AutomationProperties.Name="播放进度" />
                                    <StackPanel x:Name="TransportGroup" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PreviousButton" Style="{StaticResource PlayerIconButton}" Click="Previous_Click" IsEnabled="False" Margin="0,0,4,0" ToolTip="上一集" AutomationProperties.Name="上一集"><Path Data="M 3 3 L 3 17 M 17 3 L 7 10 L 17 17 Z" Stroke="#CFD5E0" Fill="#CFD5E0" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" /></Button>
                                        <Button x:Name="PauseButton" Content="暂停" Style="{StaticResource PrimaryPlayButton}" Click="Pause_Click" IsEnabled="False" Margin="0,0,9,0" ToolTip="播放 / 暂停 · 空格" AutomationProperties.AutomationId="PauseButton" AutomationProperties.Name="播放或暂停" />
                                        <Button x:Name="NextButton" Style="{StaticResource PlayerIconButton}" Click="Next_Click" IsEnabled="False" Margin="0,0,8,0" ToolTip="下一集" AutomationProperties.AutomationId="NextEpisodeButton" AutomationProperties.Name="下一集"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path x:Name="NextEpisodeGlyph" Data="M 3 3 L 13 10 L 3 17 Z M 17 3 L 17 17" Stroke="#CFD5E0" Fill="#CFD5E0" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" /><TextBlock x:Name="NextEpisodeLabel" Text="下一集" FontSize="11" Foreground="#CFD5E0" Visibility="Collapsed" /></StackPanel></Button>
                                        <TextBlock x:Name="TimeText" Text="00:00 / 00:00" FontFamily="Bahnschrift, Segoe UI" FontSize="11" Foreground="#7E8BA1" VerticalAlignment="Center" MinWidth="88" />
                                    </StackPanel>
                                    <StackPanel x:Name="SettingsGroup" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" VerticalAlignment="Center">
                                        <CheckBox x:Name="AutoNextCheck" Content="自动连播" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="10" ToolTip="自动播放下一集；本季完结后接续同一合集的下一季" AutomationProperties.AutomationId="AutoNextCheck" />
                                        <TextBlock Text="播放倍速" FontSize="10" Foreground="#8C99AD" Margin="0,0,0,6" />
                                        <ComboBox x:Name="SpeedCombo" SelectedIndex="2" SelectionChanged="Speed_Changed" Width="84" MinWidth="76" Height="34" Margin="0,0,8,0" ToolTip="播放倍速" AutomationProperties.Name="播放倍速" AutomationProperties.AutomationId="SpeedCombo"><ComboBoxItem Content="0.5 倍" Tag="0.5" /><ComboBoxItem Content="0.75 倍" Tag="0.75" /><ComboBoxItem Content="1.0 倍" Tag="1" /><ComboBoxItem Content="1.25 倍" Tag="1.25" /><ComboBoxItem Content="1.5 倍" Tag="1.5" /><ComboBoxItem Content="2.0 倍" Tag="2" /><ComboBoxItem Content="3.0 倍" Tag="3" /></ComboBox>
                                        <TextBlock Text="画质" FontSize="10" Foreground="#8C99AD" Margin="0,0,0,6" />
                                        <ComboBox x:Name="QualityCombo" DisplayMemberPath="Label" SelectionChanged="Quality_Changed" IsEnabled="False" Width="142" MinWidth="110" Height="34" Margin="0,0,14,0" ToolTip="切换画质，保留观看进度" AutomationProperties.Name="画质" AutomationProperties.AutomationId="QualityCombo" />
                                        <TextBlock Text="音量" FontSize="10" Foreground="#8C99AD" Margin="0,0,0,6" />
                                        <StackPanel x:Name="VolumeGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><Path Data="M 2 7 L 6 7 L 11 3 L 11 17 L 6 13 L 2 13 Z M 14 6 C 17 8 17 12 14 14 M 17 3 C 22 7 22 13 17 17" Stroke="#8C99AD" StrokeThickness="1.5" Width="17" Height="16" Stretch="Uniform" Margin="0,0,8,0" /><Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100" Value="80" Width="62" Height="24" IsMoveToPointEnabled="True" VerticalAlignment="Center" ValueChanged="Volume_Changed" ToolTip="音量" AutomationProperties.Name="音量" /></StackPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="QuickActionsGroup" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel x:Name="ToolbarVolumeGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Path Data="M 2 7 L 6 7 L 11 3 L 11 17 L 6 13 L 2 13 Z M 14 6 C 17 8 17 12 14 14" Stroke="#8C99AD" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                            <Slider x:Name="ToolbarVolumeSlider" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100" Value="{Binding Value, ElementName=VolumeSlider, Mode=TwoWay}" Width="62" Height="24" IsMoveToPointEnabled="True" ToolTip="音量" AutomationProperties.Name="主栏音量" />
                                        </StackPanel>
                                        <Button x:Name="DanmakuToggleButton" Style="{StaticResource PlayerIconButton}" Click="ToggleDanmaku_Click" ToolTip="弹幕开关 · D" AutomationProperties.Name="弹幕开关"><TextBlock x:Name="DanmakuToggleGlyph" Text="弹" FontSize="14" Foreground="{StaticResource AccentBrush}" /></Button>
                                        <Button x:Name="PlaybackOptionsButton" Style="{StaticResource PlayerIconButton}" Click="PlaybackOptions_Click" ToolTip="播放设置" AutomationProperties.Name="播放设置">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#C8CDD5" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button x:Name="FullscreenButton" Style="{StaticResource PlayerIconButton}" Click="Fullscreen_Click" ToolTip="窗口内全屏 · F11 屏幕全屏" AutomationProperties.Name="窗口内全屏"><Path x:Name="FullscreenIcon" Data="M 7 2 L 2 2 L 2 7 M 13 2 L 18 2 L 18 7 M 2 13 L 2 18 L 7 18 M 13 18 L 18 18 L 18 13" Stroke="#ABB6C8" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" /></Button>
                                    </StackPanel>
                                </Grid>
                        </Border>
                        <Border Grid.Column="1" Grid.RowSpan="2" x:Name="EpisodeSidebar" Background="#12161E" BorderBrush="#252B36" BorderThickness="1" CornerRadius="12" Margin="18,0,24,24" Padding="18">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid Width="60" Height="84" HorizontalAlignment="Left"><Grid.Clip><RectangleGeometry Rect="0,0,60,84" RadiusX="7" RadiusY="7" /></Grid.Clip><Border Background="#253044" /><Image x:Name="CurrentCover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" /></Grid>
                                    <StackPanel Grid.Column="1" Margin="7,4,0,0"><TextBlock x:Name="DetailTitle" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="52" LineHeight="18" /><TextBlock x:Name="DetailCount" Foreground="#7E8DA3" FontSize="10" Margin="0,9,0,0" /></StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" x:Name="DetailDescription" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58" Foreground="#65738A" FontSize="10" LineHeight="18" Margin="0,16,0,20" />
                                <Grid Grid.Row="2" Margin="0,0,0,14"><TextBlock Text="剧集" FontWeight="SemiBold" FontSize="13" /><TextBlock x:Name="EpisodeCountText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#65758D" FontSize="10" /></Grid>
                                <ScrollViewer Grid.Row="3" Padding="0,0,5,0"><ItemsControl x:Name="EpisodeItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:EpisodeItem}"><Button Style="{StaticResource EpisodeButton}" Width="44" Height="38" Margin="0,0,7,8" Content="{Binding Label}" Tag="{Binding}" IsEnabled="{Binding Playable}" Click="Episode_Click" ToolTip="{Binding AccessibleLabel}" AutomationProperties.Name="{Binding AccessibleLabel}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                <Border Grid.Row="4" BorderBrush="#252B36" BorderThickness="0,1,0,0" Margin="0,13,0,0" Padding="0,12,0,0"><TextBlock x:Name="FeedHint" Text="滚轮上下切换故事，也可以按 ↑ / ↓" TextWrapping="Wrap" Foreground="#7F8CA0" FontSize="10" LineHeight="17" Visibility="Collapsed" /></Border>
                                <StackPanel Grid.Row="5" Margin="0,11,0,0">
                                    <TextBlock x:Name="EngagementText" Text="正在读取互动信息…" Foreground="#7D8BA1" FontSize="10" TextWrapping="Wrap" LineHeight="17" Margin="1,0,1,10" />
                                    <Button x:Name="DiscussionButton" Style="{StaticResource GhostButton}" Background="#202632" Padding="12,10" Click="Discussion_Click" AutomationProperties.Name="查看评论与弹幕">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="M 3 3 L 19 3 L 19 15 L 10 15 L 5 19 L 5 15 L 3 15 Z M 7 7 L 15 7 M 7 11 L 12 11" Stroke="#A7B4C8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="评论与弹幕" Foreground="#CFD8E6" FontSize="11" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- 讨论区只占右侧栏，避免遮挡原生视频窗口。 -->
                        <Border Grid.Column="1" Grid.RowSpan="2" x:Name="DiscussionPanel" Visibility="Collapsed" Background="#12161E" BorderBrush="#252B36" BorderThickness="1" CornerRadius="12" Margin="18,0,24,24" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="评论与弹幕" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="30" Height="30" Click="CloseDiscussion_Click" ToolTip="返回选集" AutomationProperties.Name="关闭评论与弹幕"><Path Data="M 3 3 L 15 15 M 15 3 L 3 15" Stroke="#95A3B9" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" /></Button>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button x:Name="CommentsTabButton" Style="{StaticResource ChannelButton}" Content="评论" Click="CommentsTab_Click" Margin="0,0,6,0" Padding="10,8" />
                                    <Button x:Name="DanmakuTabButton" Grid.Column="1" Style="{StaticResource ChannelButton}" Content="弹幕列表" Click="DanmakuTab_Click" Padding="10,8" />
                                </Grid>
                                <TextBlock x:Name="DiscussionStatus" Grid.Row="2" Text="正在读取讨论…" Foreground="#8391A7" FontSize="10" TextWrapping="Wrap" LineHeight="17" Margin="1,0,1,12" />
                                <ScrollViewer x:Name="DiscussionScroll" Grid.Row="3" Padding="0,0,4,0" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="DiscussionItems"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Style="{StaticResource PosterButton}" Tag="{Binding}" Click="DiscussionItem_Click" Margin="0,0,0,10" Background="#171C26" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding AuthorLabel}">
                                            <StackPanel Margin="10,9">
                                                <TextBlock Text="{Binding AuthorLabel}" Foreground="#B9C6D9" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Text}" Foreground="#E0E6EF" FontSize="11" TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,0" />
                                                <TextBlock Text="{Binding Meta}" Foreground="#6E7D94" FontSize="10" TextWrapping="Wrap" LineHeight="16" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </ScrollViewer>
                                <Button x:Name="DiscussionMoreButton" Grid.Row="4" Content="加载更多" Style="{StaticResource GhostButton}" Click="DiscussionMore_Click" FontSize="11" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                <Grid x:Name="RankingScreen" Margin="28,24,28,0" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid x:Name="RankingHeading" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="此刻，值得一看" FontSize="22" FontWeight="SemiBold" /><TextBlock x:Name="RankExplanation" Text="榜单由平台提供，选择榜单查看对应内容。" Foreground="#8190A6" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,8,14,0" /></StackPanel>
                        <TextBlock x:Name="RankingFreshnessText" Grid.Column="1" Text="" Foreground="#6B7D94" FontSize="10" VerticalAlignment="Top" Margin="12,7,0,0" />
                    </Grid>
                    <Grid x:Name="RankTabsPanel" Grid.Row="1" Margin="0,0,0,16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="RankContentTabsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="RankTabs_MouseWheel" Padding="0,0,0,3" Margin="0,0,14,0"><StackPanel x:Name="RankContentTabs" Orientation="Horizontal" AutomationProperties.Name="排行榜作品类型" /></ScrollViewer>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="RankCategoryButton" Style="{StaticResource GhostButton}" Click="RankCategory_Click" Content="分类 ▾" Padding="12,9" FontSize="11" Height="38" Margin="0,0,6,0" AutomationProperties.Name="展开排行榜题材分类" />
                            <Button Style="{StaticResource GhostButton}" Click="RankRefresh_Click" Content="刷新榜单" Padding="12,9" FontSize="11" Height="38" />
                        </StackPanel>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#232A35" BorderThickness="0,1,0,1" Padding="0,9,0,8" Margin="0,10,0,0">
                            <ScrollViewer x:Name="RankBoardTabsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="RankTabs_MouseWheel" Padding="0,0,0,3"><StackPanel x:Name="RankBoardTabs" Orientation="Horizontal" AutomationProperties.Name="排行榜平台榜单" /></ScrollViewer>
                        </Border>
                        <TextBlock x:Name="RankCategorySummary" Grid.Row="2" Grid.ColumnSpan="2" Text="" Visibility="Collapsed" Foreground="#CF9D89" FontSize="10" TextWrapping="Wrap" Margin="3,9,3,0" />
                        <!-- 保留既有选择状态与事件，主入口使用上方两排横向标签。 -->
                        <ComboBox x:Name="RankContentCombo" Visibility="Collapsed" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="RankContent_Changed" />
                        <ComboBox x:Name="RankBoardCombo" Visibility="Collapsed" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="RankBoard_Changed" />
                    </Grid>
                    <Border x:Name="RankGenrePanel" Grid.Row="2" Visibility="Collapsed" Background="#11151D" BorderBrush="#242B36" BorderThickness="1" CornerRadius="12" Padding="13,11" Margin="0,0,0,18">
                        <ScrollViewer x:Name="RankGenreScroll" MaxHeight="116" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel>
                            <Grid x:Name="RankGenreControls"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,9,0"><TextBlock Text="主题分类" FontSize="10" Foreground="#A4B0C3" Margin="1,0,0,7" /><ComboBox x:Name="RankThemeCombo" Tag="category_dim_theme" DisplayMemberPath="Name" SelectedValuePath="Value" SelectionChanged="RankGenre_Changed" IsEnabled="False" Height="35" MinWidth="100" AutomationProperties.Name="排行榜主题分类" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,9,0"><TextBlock Text="人物设定" FontSize="10" Foreground="#A4B0C3" Margin="1,0,0,7" /><ComboBox x:Name="RankSettingCombo" Tag="category_dim_role" DisplayMemberPath="Name" SelectedValuePath="Value" SelectionChanged="RankGenre_Changed" IsEnabled="False" Height="35" MinWidth="100" AutomationProperties.Name="排行榜人物设定分类" /></StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,9,0"><TextBlock Text="故事背景" FontSize="10" Foreground="#A4B0C3" Margin="1,0,0,7" /><ComboBox x:Name="RankBackgroundCombo" Tag="category_dim_epoch" DisplayMemberPath="Name" SelectedValuePath="Value" SelectionChanged="RankGenre_Changed" IsEnabled="False" Height="35" MinWidth="100" AutomationProperties.Name="排行榜故事背景分类" /></StackPanel>
                                <Button x:Name="ClearRankGenresButton" Grid.Column="3" Content="全部题材" Style="{StaticResource GhostButton}" Click="ClearRankGenres_Click" Padding="11,8" FontSize="10" Height="35" VerticalAlignment="Bottom" IsEnabled="False" ToolTip="清除题材，返回所选平台榜单" />
                            </Grid>
                            <TextBlock x:Name="RankGenreHint" Text="正在读取平台题材分类…" TextWrapping="Wrap" FontSize="10" Foreground="#72829A" LineHeight="17" Margin="1,10,1,0" />
                        </StackPanel></ScrollViewer>
                    </Border>
                    <ScrollViewer Grid.Row="3" x:Name="RankScroll" Padding="0,0,6,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><ItemsControl x:Name="RankingItems" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource RankListRowButton}" Margin="0,0,0,11" Tag="{Binding}" Click="RankSeries_Click" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="整行可点击，打开剧集观看">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="98" /><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding PositionLabel}" Foreground="{Binding PositionColor}" FontFamily="Bahnschrift, Segoe UI" FontWeight="SemiBold" FontSize="28" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding RankContextLabel}" Foreground="#65758D" FontSize="9" HorizontalAlignment="Center" Margin="0,7,0,0" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" Width="80" Height="112" HorizontalAlignment="Left"><Grid.Clip><RectangleGeometry Rect="0,0,80,112" RadiusX="8" RadiusY="8" /></Grid.Clip>
                                        <Border Background="#1C2738" />
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="#6F7F96" FontSize="9" Margin="9" MaxHeight="62" />
                                        <Image local:CoverImages.Url="{Binding CoverUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,1,22,1">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="23" ToolTip="{Binding Title}" />
                                        <Border Background="#202735" CornerRadius="5" HorizontalAlignment="Left" Padding="7,3" Margin="0,10,0,0"><TextBlock Text="{Binding EpisodeLabel}" Foreground="#9EADC2" FontSize="10" /></Border>
                                        <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" FontSize="10" LineHeight="18" Foreground="#7889A2" Margin="0,9,0,0">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Intro}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Intro}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Width="116">
                                        <TextBlock Text="{Binding DisplayScoreLabel}" Foreground="#D5AA84" FontSize="11" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap" LineHeight="18" Margin="0,0,1,14" />
                                        <Border Background="#30221F" BorderBrush="#624239" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Right" Padding="17,9" IsHitTestVisible="False">
                                            <StackPanel Orientation="Horizontal"><Path Data="M 0 0 L 0 11 L 9 5.5 Z" Fill="#FFAA92" Width="9" Height="11" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="观看" Foreground="#FFB09A" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl></ScrollViewer>
                    <Grid x:Name="RankingFooter" Grid.Row="4" Margin="0,10,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="RankStatus" Text="正在加载榜单…" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="#6F7D93" VerticalAlignment="Center" Margin="0,0,12,0" /><Button Grid.Column="1" x:Name="RankMoreButton" Content="加载更多" Style="{StaticResource GhostButton}" Click="RankMore_Click" Padding="14,7" FontSize="11" Visibility="Collapsed" /></Grid>
                </Grid>
                <Grid x:Name="HistoryScreen" Margin="28,24" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,22"><StackPanel><TextBlock Text="故事，接着看" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="上次看到的精彩，还在这里。" FontSize="11" Foreground="#6D7B90" Margin="0,9,0,0" /></StackPanel><Button Content="刷新记录" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="History_Click" Padding="14,8" FontSize="11" /></Grid>
                    <ScrollViewer Grid.Row="1"><ItemsControl x:Name="HistoryItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:HistoryItem}">
                        <Border Width="192" Background="#141820" BorderBrush="#242B37" BorderThickness="1" CornerRadius="12" Margin="0,0,18,22" Padding="11"><StackPanel>
                            <Grid Width="168" Height="228"><Grid.Clip><RectangleGeometry Rect="0,0,168,228" RadiusX="8" RadiusY="8" /></Grid.Clip><Border Background="#202A3B" /><TextBlock Text="{Binding Title}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14" Foreground="#65748D" /><Image local:CoverImages.Url="{Binding CoverUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" /></Grid>
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="1,13,1,0" ToolTip="{Binding Title}" /><TextBlock Text="{Binding ProgressLabel}" Foreground="#A2AEC1" FontSize="10" Margin="1,9,1,0" /><TextBlock Text="{Binding DateLabel}" Foreground="#53627A" FontSize="10" Margin="1,6,1,14" />
                            <Button Style="{StaticResource GhostButton}" Tag="{Binding}" Click="Resume_Click" Padding="10,9" Background="#202632" AutomationProperties.Name="继续观看"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="M 0 0 L 0 11 L 9 5.5 Z" Fill="{StaticResource AccentBrush}" Width="9" Height="11" Stretch="Uniform" Margin="0,0,7,0" /><TextBlock Text="继续观看" FontSize="11" Foreground="#D5DDE9" /></StackPanel></Button>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
