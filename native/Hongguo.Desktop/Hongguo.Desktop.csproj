<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>红果原生桌面版</AssemblyName>
    <RootNamespace>Hongguo.Desktop</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" />
    <EmbeddedResource Include="Resources\ohg-native-bridge.exe" LogicalName="Hongguo.Desktop.Resources.ohg-native-bridge.exe" />
    <EmbeddedResource Include="..\runtime\mpv\libmpv-2.dll" LogicalName="Hongguo.Desktop.Resources.libmpv-2.dll" Condition="Exists('..\runtime\mpv\libmpv-2.dll')" />
    <EmbeddedResource Include="..\runtime\mpv\vulkan-1.dll" LogicalName="Hongguo.Desktop.Resources.vulkan-1.dll" Condition="Exists('..\runtime\mpv\vulkan-1.dll')" />
    <EmbeddedResource Include="..\runtime\mpv\Copyright" LogicalName="Hongguo.Desktop.Resources.Copyright" />
    <EmbeddedResource Include="..\runtime\mpv\LICENSE.GPL" LogicalName="Hongguo.Desktop.Resources.LICENSE.GPL" />
    <EmbeddedResource Include="..\runtime\mpv\Vulkan-Loader-LICENSE.txt" LogicalName="Hongguo.Desktop.Resources.Vulkan-Loader-LICENSE.txt" />
    <EmbeddedResource Include="..\runtime\imaging\Magick.NET-LICENSE.txt" LogicalName="Hongguo.Desktop.Resources.Magick.NET-LICENSE.txt" />
    <EmbeddedResource Include="..\runtime\imaging\magick.net-q8-x64-NOTICE.txt" LogicalName="Hongguo.Desktop.Resources.Magick.NET-NOTICE.txt" />
  </ItemGroup>
</Project>
